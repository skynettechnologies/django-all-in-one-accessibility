# Documentation
include README.md
include LICENSE

# Static files and templates
recursive-include accessibility/static *
recursive-include accessibility/templates *

# Migrations
recursive-include accessibility/migrations *.py

# Exclude unwanted files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.swp
global-exclude *.orig
global-exclude *~

# Python source files (explicit inclusion for sdist)
recursive-include accessibility *.py
